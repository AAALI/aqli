# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Merge engine (spec §3). On by default since step 6 of the markdown-canonical
# migration: document saves go through `propose -> merge`, which is what writes
# `body_md` and records a revision. Set to 0 to fall back to direct writes —
# a rollback lever, not a supported mode (saves stop producing revisions).
# AQLI_MERGE_ENGINE=1

# OpenAI (required for embeddings + agent context retrieval)
OPENAI_API_KEY=sk-...

# Linear (optional — enables issue/project preview in the doc sidebar)
LINEAR_API_KEY=lin_api_...

# Composio (optional — enables user-managed GitHub/Linear integrations)
COMPOSIO_API_KEY=cmp_...
COMPOSIO_WEBHOOK_SECRET=whsec_...
COMPOSIO_WEBHOOK_URL=https://your-aqli.app/api/integrations/composio/webhook
