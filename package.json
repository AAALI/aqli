{
  "name": "aqli",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "confluence:synthesize": "tsx scripts/synthesize-confluence-corpus.ts",
    "confluence:fidelity": "tsx scripts/confluence-fidelity.ts",
    "backfill:markdown": "tsx scripts/backfill-markdown.ts",
    "test:sql": "./supabase/tests/run.sh",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@tiptap/core": "3.26.0",
    "@tiptap/extension-blockquote": "3.26.0",
    "@tiptap/extension-code-block": "^3.28.0",
    "@tiptap/extension-image": "^3.26.0",
    "@tiptap/extension-list": "3.26.0",
    "@tiptap/extension-table": "^3.26.0",
    "@tiptap/extensions": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "hast-util-to-string": "^3.0.1",
    "markdown-it": "^14.3.0",
    "mermaid": "^11.16.0",
    "next": "16.2.7",
    "openai": "^6.42.0",
    "posthog-js": "^1.383.3",
    "posthog-node": "^5.36.8",
    "prosemirror-markdown": "^1.13.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-parse": "^9.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/hast": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "fast-check": "^4.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.6",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
